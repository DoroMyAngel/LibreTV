{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libretv-next",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEFAULT_SOURCES": "[{\"name\":\"电影天堂资源\",\"url\":\"http://caiji.dyttzyapi.com/api.php/provide/vod\",\"detail\":\"http://caiji.dyttzyapi.com\",\"isAdult\":false},{\"name\":\"暴风资源\",\"url\":\"https://bfzyapi.com/api.php/provide/vod\",\"isAdult\":false},{\"name\":\"非凡影视\",\"url\":\"http://ffzy5.tv/api.php/provide/vod\",\"detail\":\"http://ffzy5.tv\",\"isAdult\":false}]"
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "libretv-opennext-cache"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "WORKER_SELF_REFERENCE",
        "type": "service",
        "service": "libretv-next",
        "environment": "production",
        "entrypoint": "default"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
