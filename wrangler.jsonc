{
  // ...
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "libretv-opennext-cache"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "WORKER_SELF_REFERENCE",
        "type": "service",
        "service": "libretv-next",
        "environment": "production",
        "entrypoint": "default"
      }
    ]
  },
  // ...
}
